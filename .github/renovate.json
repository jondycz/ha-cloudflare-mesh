{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": false,
  "enabledManagers": [
    "dockerfile"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "cloudflare/mesh"
      ],
      "groupName": "Cloudflare Mesh",
      "commitMessageTopic": "Cloudflare Mesh base image",
      "semanticCommitType": "build"
    }
  ],
  "labels": [
    "dependencies"
  ]
}
